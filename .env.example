# =================================================================
# TabibiGo Client Backend - Environment Configuration Reference
# =================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection
# MongoDB Atlas connection string (Requires Whitelist: Add your IP or 0.0.0.0/0 in Atlas Network Access)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/TabibiGo-Users?retryWrites=true&w=majority

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
JWT_PENDING_SECRET=your_super_secret_jwt_pending_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth (Optional - Audience check for POST /api/auth/google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# OTP & Email Delivery (Nodemailer SMTP)
OTP_SECRET=your_otp_hmac_secret_key_change_in_production
SMTP_EMAIL=tabibigo.team@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password_16_characters

# Internal Admin Service-to-Service Security (HMAC-SHA256)
INTERNAL_SERVICE_SECRET=your_shared_hmac_secret_between_client_and_admin_backends
ALLOW_INSECURE_INTERNAL_API_KEY=false

# File Storage Configuration
# local (stores in ./storage/documents) or cloud provider
STORAGE_PROVIDER=local
